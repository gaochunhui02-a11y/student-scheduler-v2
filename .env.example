# Copy this file to ".env" and fill in your own Supabase project's values.
# Find these under: Supabase dashboard -> Project Settings -> API Keys
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the "publishable" key — it is SAFE to use in
# frontend code, because every request it makes is still checked against your
# Row Level Security policies. Never put the "secret" key (sometimes shown as
# "service_role" on older projects) in this file or in any frontend code —
# that key bypasses RLS entirely and must stay server-side only (this project
# never needs it).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
